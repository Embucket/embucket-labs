# Embucket UI Lambda POC - Environment Variables
# Copy this file to .env and fill in your values
# For AWS Lambda, set these in Configuration → Environment variables

# Postgres Database Configuration
# Required if you want to use Postgres for metadata storage
DB_HOST=embucket-poc-db.cluster-cv4qo6eeg19t.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=embucket-poc-db
DB_USER=embucket
DB_PASSWORD=embucket
DB_SSL=true

# Optional: Query Lambda Configuration
# Uncomment if you want to integrate with Rust Query Lambda
# QUERY_LAMBDA_FUNCTION_NAME=embucket-query-lambda
# QUERY_LAMBDA_REGION=us-east-1

# Optional: AWS Region
# AWS_REGION=us-east-1

# Notes:
# - DB_SSL should be 'true' for RDS/Aurora, 'false' for local development
# - If DB_HOST is not set, the app will use mock data
# - For production, use AWS Secrets Manager instead of environment variables for passwords
